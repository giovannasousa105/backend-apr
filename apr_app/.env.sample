# Development environment variables for apr_app

# API backend (controls `/auth/login` and `/v1/*` calls).
# When running locally, start the backend on localhost:8000 (or change this URL).
API_BASE_URL=http://localhost:8000

# Supabase configuration (used by the floating cart/chat panel).
# Replace the placeholder values with the URL/anon key for the Supabase
# instance you want the app to read from.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=public-anon-key-for-dev

# Toggle production mode when running against production Supabase infra.
SUPABASE_PRODUCTION=false

# Optional tags used for lightweight analytics/logging.
SUPABASE_ANALYTICS_DEV=dev-cart-reader
SUPABASE_ANALYTICS_PROD=prod-cart-reader
